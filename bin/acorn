#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_NAME="acorn"
PROJECTS_DIR="${PROJECTS_DIR:-$HOME/projects}"
LIFECYCLE_LABELS=("triage" "ready-for-spec" "spec-in-progress" "spec-review" "spec-approved" "implementing" "in-review" "review-pass" "review-blocked" "review-skipped" "done")
CLARIFICATION_LABELS=("ai-drafted" "human-clarified")
TELEGRAM_NOTIFY_PORT="${TELEGRAM_NOTIFY_PORT:-8765}"
TELEGRAM_NOTIFY_URL="http://127.0.0.1:${TELEGRAM_NOTIFY_PORT}/notify"
ACORN_SUBAGENT_RETRY_BUDGET="${ACORN_SUBAGENT_RETRY_BUDGET:-1}"
ACORN_SUBAGENT_RETRY_BACKOFF_SECONDS="${ACORN_SUBAGENT_RETRY_BACKOFF_SECONDS:-30}"
ACORN_FAILURE_EVENT_PATH="${ACORN_FAILURE_EVENT_PATH:-}"
_SHOW_DEPS=0
_LIST_NWO=""
ACORN_OUTPUT_MODE="${ACORN_OUTPUT_MODE:-single}"

# Ensure npm-global bin is on PATH so `claude` resolves in non-interactive shells
# (e.g. Foreman background spawns).
export PATH="/home/agentdev/.npm-global/bin${PATH:+:$PATH}"
# Defense-in-depth (R-1b): warn if `claude` resolves outside the expected npm-global location.
_claude_bin=$(command -v claude 2>/dev/null || true)
case "$_claude_bin" in
    "" | "/home/agentdev/.npm-global/bin/claude") ;;
    *) printf '[WARN] claude resolved to unexpected path: %s
' "$_claude_bin" >&2 ;;
esac
unset _claude_bin
auto_trigger_message() {
  local spec_path="$1"
  local mode="${2:-full}"
  local msg
  case "$mode" in
    full)  msg=$(printf 'Read %s/PROMPT.md and follow ALL instructions in it to execute the full 6-stage planning pipeline. Start with Stage 0 (Recon). Write all output files to %s/' "$spec_path" "$spec_path") ;;
    lite)  msg=$(printf 'Read %s/PROMPT.md and follow ALL instructions in it to execute the lite 4-stage planning pipeline. Start with Stage 0 (Recon). Write all output files to %s/' "$spec_path" "$spec_path") ;;
    quick) msg=$(printf 'Read %s/PROMPT.md and follow ALL instructions in it to execute the quick 2-stage planning pipeline. Start with Stage 0 (Recon). Write all output files to %s/' "$spec_path" "$spec_path") ;;
  esac
  if [ "${ACORN_CLARIFY_ENABLED:-0}" = "1" ]; then
    msg="${msg} IMPORTANT: PROMPT.md begins with a /clarify pre-Stage-0 block; complete it before Stage 0 Recon."
  fi
  printf '%s' "$msg"
}

info() { printf '[INFO] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

notify_telegram() {
  local message="$1"
  local session="${2:-}"

  # Fire-and-forget: never block acorn on notification failure
  (
    if ! command -v curl >/dev/null 2>&1; then
      return 0
    fi

    local payload
    if [ -n "$session" ]; then
      payload="$(jq -nc --arg m "$message" --arg s "$session" '{message: $m, session: $s}')"
    else
      payload="$(jq -nc --arg m "$message" '{message: $m}')"
    fi

    curl -fsS --max-time 5 \
      -H "Content-Type: application/json" \
      -d "$payload" \
      "$TELEGRAM_NOTIFY_URL" >/dev/null 2>&1 \
      || true
  ) &
  disown
}

notify_foreman() {
  local event_type="$1"
  local message="$2"
  local session="${3:-}"
  local extra_data="${4:-{}}"

  (
    if ! command -v curl >/dev/null 2>&1; then
      return 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
      local tg_payload
      tg_payload="{\"message\": \"$message\"}"
      curl -fsS --max-time 5 \
        -H "Content-Type: application/json" \
        -d "$tg_payload" \
        "$TELEGRAM_NOTIFY_URL" >/dev/null 2>&1 || true
      return 0
    fi

    if ! jq -e . >/dev/null 2>&1 <<<"$extra_data"; then
      extra_data='{}'
    fi

    local payload
    payload="$(jq -nc \
      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg event "$event_type" \
      --arg session "$session" \
      --argjson data "$extra_data" \
      '{ts: $ts, event: $event, source: "acorn", session: $session, data: $data}')"

    local http_code
    http_code=$(curl -s --max-time 3 \
      -o /dev/null -w '%{http_code}' \
      -X POST -H "Content-Type: application/json" \
      -d "$payload" \
      "http://localhost:7700/notify-foreman" 2>/dev/null) || http_code="0"

    if [[ "$http_code" != "200" ]]; then
      local tg_payload
      if [ -n "$session" ]; then
        tg_payload="$(jq -nc --arg m "$message" --arg s "$session" '{message: $m, session: $s}')"
      else
        tg_payload="$(jq -nc --arg m "$message" '{message: $m}')"
      fi
      curl -fsS --max-time 5 \
        -H "Content-Type: application/json" \
        -d "$tg_payload" \
        "$TELEGRAM_NOTIFY_URL" >/dev/null 2>&1 || true
    fi
  ) &
  disown
}

stage_manifest() {
  local mode="$1" stage="$2"
  case "$mode:$stage" in
    full:pre0|lite:pre0|quick:pre0)
      printf '%s\n' "${ACORN_CLARIFICATIONS_FILENAME:-clarifications.md}|^# Clarifications:"
      ;;
    full:0|lite:0|quick:0)
      printf '%s\n' \
        'recon/architecture.md|^## Directory Structure' \
        'recon/relevant_code.md|^## ' \
        'recon/conventions.md|^## '
      ;;
    full:1)
      printf '%s\n' 'plans/draft_plan_1.md|^## ' 'plans/draft_plan_2.md|^## ' 'plans/draft_plan_3.md|^## ' 'plans/draft_plan_4.md|^## '
      ;;
    full:2) printf '%s\n' 'plans/evaluation.md|^## ' ;;
    full:3) printf '%s\n' 'plans/master_plan.md|^## ' ;;
    full:4)
      printf '%s\n' 'plans/red_team_1.md|^## ' 'plans/red_team_2.md|^## ' 'plans/red_team_3.md|^## ' 'plans/red_team_4.md|^## '
      ;;
    full:5|lite:3|quick:1) printf '%s\n' 'plans/SPEC.md|^## ' ;;
    lite:1) printf '%s\n' 'plans/draft.md|^## ' ;;
    lite:2) printf '%s\n' 'plans/validation.md|^## ' ;;
    *) die "Unknown stage manifest: mode=$mode stage=$stage" ;;
  esac
}

stage_name() {
  local mode="$1" stage="$2"
  case "$mode:$stage" in
    *:pre0) printf 'pre-stage-0 /clarify' ;;
    *:0) printf 'recon' ;;
    full:1|lite:1) printf 'drafting' ;;
    full:2|lite:2) printf 'validation' ;;
    full:3) printf 'synthesis' ;;
    full:4) printf 'red-team' ;;
    full:5|lite:3|quick:1) printf 'final-spec' ;;
    *) printf 'unknown' ;;
  esac
}

validate_stage_artifacts() {
  local spec_dir="$1" mode="$2" stage="$3"
  [ -d "$spec_dir" ] || { printf 'MISSING|%s\n' "$spec_dir" >&2; return 1; }
  local manifest path header full rc=0
  manifest="$(stage_manifest "$mode" "$stage")"
  while IFS='|' read -r path header; do
    [ -n "$path" ] || continue
    full="$spec_dir/$path"
    if [ ! -f "$full" ]; then printf 'MISSING|%s\n' "$path" >&2; rc=1; continue; fi
    if [ ! -s "$full" ]; then printf 'EMPTY|%s\n' "$path" >&2; rc=1; continue; fi
    if [ -n "$header" ] && ! grep -E -q -- "$header" "$full"; then
      printf 'HEADER|%s|%s\n' "$path" "$header" >&2; rc=1
    fi
  done <<< "$manifest"

  if [ "$rc" -eq 0 ] && [ "$stage" = "pre0" ]; then
    local clarify_file="$spec_dir/${ACORN_CLARIFICATIONS_FILENAME:-clarifications.md}"
    if [ -f "$clarify_file" ] && grep -q "_(not yet answered)_" "$clarify_file"; then
      printf 'SKELETON|%s|unanswered placeholders\n' "$clarify_file" >&2
      rc=1
    fi
  fi

  return "$rc"
}

emit_failure_event() {
  local event_path="${ACORN_FAILURE_EVENT_PATH:-}"
  [ -n "$event_path" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local slug="${1:-}" stage="${2:-0}" sname="${3:-}" agent="${4:-}" artifact="${5:-}" retry_count="${6:-0}" retry_budget="${7:-0}" halt_reason="${8:-}" observed="${9:-}" mode="${10:-}" repo="${11:-}" issue_number="${12:-0}" session_name="${13:-}"
  case "$stage" in ''|*[!0-9]*) stage=0;; esac
  case "$retry_count" in ''|*[!0-9]*) retry_count=0;; esac
  case "$retry_budget" in ''|*[!0-9]*) retry_budget=0;; esac
  case "$issue_number" in ''|*[!0-9]*) issue_number=0;; esac
  local payload
  payload="$(jq -nc --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg slug "$slug" --argjson stage "$stage" --arg stage_name "$sname" --arg agent "$agent" --arg artifact "$artifact" --argjson retry_count "$retry_count" --argjson retry_budget "$retry_budget" --arg halt_reason "$halt_reason" --arg observed "$observed" --arg mode "$mode" --arg repo "$repo" --argjson issue_number "$issue_number" --arg session_name "$session_name" '{ts:$ts,source:"acorn",event:"subagent.halt",slug:$slug,repo:$repo,issue_number:$issue_number,mode:$mode,stage:$stage,stage_name:$stage_name,agent:$agent,artifact:$artifact,retry_count:$retry_count,retry_budget:$retry_budget,halt_reason:$halt_reason,observed:$observed,session_name:$session_name}' 2>/dev/null)" || return 0
  mkdir -p "$(dirname "$event_path")" 2>/dev/null || true
  printf '%s\n' "$payload" >> "$event_path" 2>/dev/null || true
}

halt_pipeline_diagnostic() {
  local spec_dir="$1" mode="$2" stage="$3" agent="$4" artifact="$5" halt_reason="$6" observed="$7" agent_log_tail="${8:-(no output captured)}"
  agent_log_tail="${agent_log_tail//\`\`\`/~~~}"
  local stage_dir halt_path sname slug repo issue_number session_name ts body
  case "$stage" in
    0) stage_dir="$spec_dir/recon" ;;
    pre*) stage_dir="$spec_dir" ;;
    *) stage_dir="$spec_dir/plans" ;;
  esac
  mkdir -p "$stage_dir" 2>/dev/null || true
  halt_path="$stage_dir/HALT.md"
  sname="$(stage_name "$mode" "$stage")"
  slug="$(jq -r '.slug // ""' "$spec_dir/meta.json" 2>/dev/null || true)"
  repo="$(jq -r '.repo // ""' "$spec_dir/meta.json" 2>/dev/null || true)"
  issue_number="$(jq -r '.issue_number // 0' "$spec_dir/meta.json" 2>/dev/null || printf '0')"
  session_name="$(jq -r '.session_name // ""' "$spec_dir/meta.json" 2>/dev/null || true)"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  body="$(printf '# Pipeline Halt: stage %s (%s)\n\nHalted at: %s\nPipeline mode: %s\nSpec slug: %s\nRepo: %s\nStage: %s (%s)\nFailed agent: %s\nExpected artifact: %s\nObserved: %s\nRetry budget: %s\nHalt reason: %s\n\n## Last 50 lines of agent output\n\n```\n%s\n```\n\n## Suggested operator action\n\n    acorn clean %s %s --yes\n    acorn create %s %s --%s\n' "$stage" "$sname" "$ts" "$mode" "$slug" "$repo" "$stage" "$sname" "$agent" "$artifact" "$observed" "${ACORN_SUBAGENT_RETRY_BUDGET:-1}" "$halt_reason" "$agent_log_tail" "$repo" "$slug" "$repo" "$issue_number" "$mode")"
  if ! printf '%s\n' "$body" > "$halt_path" 2>/dev/null; then warn "Failed to write $halt_path"; printf '%s\n' "$body" >&2; fi
  warn "Pipeline halted: $sname stage (mode=$mode)"
  warn "  Failed agent: $agent"
  warn "  Expected artifact: $artifact"
  warn "  Observed: $observed"
  warn "  Halt reason: $halt_reason"
  warn "  Diagnostic: $halt_path"
  emit_failure_event "$slug" "$stage" "$sname" "$agent" "$artifact" "${ACORN_SUBAGENT_RETRY_BUDGET:-1}" "${ACORN_SUBAGENT_RETRY_BUDGET:-1}" "$halt_reason" "$observed" "$mode" "$repo" "$issue_number" "$session_name"
  return 1
}

check_circuit_breaker() {
  local forged_url="http://localhost:7700/status"
  local response
  set +e
  response="$(curl -fsS --max-time 3 "$forged_url" 2>/dev/null)"
  local ec=$?
  set -e

  if [ $ec -ne 0 ]; then
    warn "Forged not reachable -- skipping circuit breaker check (fail-open)"
    return 0
  fi

  local blocked
  blocked="$(printf '%s' "$response" | jq -r '.acorn_circuit_breaker.blocked // false' 2>/dev/null)"
  if [ "$blocked" = "true" ]; then
    die "Acorn circuit breaker is TRIPPED (systemic idle failures). Reset via: curl -X POST localhost:7700/reset-acorn-circuit-breaker"
  fi
  return 0
}

register_with_forged() {
  local session_name="$1"
  local mode="$2"
  local spec_dir="$3"
  local payload
  payload="$(jq -nc \
    --arg session "$session_name" \
    --arg type "acorn" \
    --arg mode "$mode" \
    --arg spec_dir "$spec_dir" \
    '{session: $session, type: $type, meta: {mode: $mode, spec_dir: $spec_dir}}')"
  (
    curl -fsS --max-time 3 \
      -H "Content-Type: application/json" \
      -d "$payload" \
      "http://localhost:7700/register" >/dev/null 2>&1 \
      || true
  ) &
  disown
}


usage() {
  cat <<'EOF'
Usage:
  acorn create <repo> <issue-number> [--no-auto] [--lite | --quick]
  acorn list [repo] [--deps]
  acorn status [repo]
  acorn approve <repo> <slug> [--no-commit] [--orphan-branch <branch>]
  acorn spec-complete <repo> <slug>
  acorn clean <repo> <slug> [--remove-labels] [--yes] [--force]
  acorn doctor [repo]
  acorn issue create <repo> <title> [--body <text> | --body-file <path> | --raw] [--label <name>]... [--assignee <login>]... [--blocked-by <issue#>[,<issue#>...]]
  acorn issue plan <repo> <title> [options] [--blocked-by <issue#>[,<issue#>...]] [--no-auto] [--lite | --quick]
  acorn issue clarify <repo> <issue-number>
  acorn issue label <repo> <issue-number> <label>
  acorn issue split <repo> <issue-number> [--yes] [--model <model>]
  acorn issue depends <repo> <issue#> [--blocked-by <issue#>[,<issue#>...]] [--remove-blocked-by <issue#>[,<issue#>...]]
  acorn deps graph <repo> <issue#> [<issue#>...]

Pipeline modes:
  (default)   Full 6-stage pipeline — 14 agents, Opus recon + Opus planning
  --lite      Lite 4-stage pipeline — 6 agents, Sonnet recon + Opus planning
  --quick     Quick 2-stage pipeline — 4 agents, Sonnet recon + Opus direct spec

Dependency management:
  acorn issue depends <repo> <issue#>                       Show dependencies
  acorn issue depends <repo> <issue#> --blocked-by 5,12     Add blockers
  acorn issue depends <repo> <issue#> --remove-blocked-by 5 Remove a blocker
  acorn deps graph <repo> <issue#> [<issue#>...]            Show wave execution order

Lifecycle labels:
  triage -> ready-for-spec -> spec-in-progress -> spec-review -> spec-approved -> implementing -> in-review -> done

Environment Variables:
  ACORN_CLARIFY_ENABLED=1                  Enable pre-Stage-0 /clarify block and gate flow
  ACORN_CLARIFICATIONS_FILENAME=<filename> Override clarify artifact filename (default: clarifications.md)
EOF
}

require_cmds() {
  local missing=()
  local cmd
  for cmd in "$@"; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    die "Missing required command(s): ${missing[*]}"
  fi
}

repo_main_path() {
  local repo="$1"
  local worktree_path="$PROJECTS_DIR/$repo/main"
  local flat_path="$PROJECTS_DIR/$repo"
  if [ -d "$worktree_path" ]; then
    printf '%s' "$worktree_path"
  else
    printf '%s' "$flat_path"
  fi
}

spec_root() {
  local repo="$1"
  printf '%s/.specs' "$(repo_main_path "$repo")"
}

spec_dir() {
  local repo="$1"
  local slug="$2"
  printf '%s/%s' "$(spec_root "$repo")" "$slug"
}

safe_repo_main() {
  local repo="$1"
  local repo_main
  repo_main="$(repo_main_path "$repo")"
  [ -d "$repo_main" ] || die "Repo path not found: $repo_main"
  printf '%s' "$repo_main"
}

slugify_title() {
  local title="$1"
  local s
  if command -v iconv >/dev/null 2>&1; then
    s="$(printf '%s' "$title" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null || printf '%s' "$title")"
  else
    s="$title"
  fi

  s="$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]')"
  s="$(printf '%s' "$s" | tr ' _' '--')"
  s="$(printf '%s' "$s" | sed -E 's/[^a-z0-9-]+/-/g; s/-+/-/g; s/^-+//; s/-+$//')"
  s="$(printf '%s' "$s" | cut -c1-50)"
  s="$(printf '%s' "$s" | sed -E 's/-+$//')"

  if [ -z "$s" ]; then
    s="issue"
  fi
  printf '%s' "$s"
}

build_slug() {
  local issue_number="$1"
  local title="$2"
  printf '%s-%s' "$issue_number" "$(slugify_title "$title")"
}

canonical_session_name() {
  local repo="$1"
  local slug="$2"
  local session="${repo}/specs/${slug}/claude"
  session="$(printf '%s' "$session" | sed -E 's#[[:space:]/]+#_#g; s/[^A-Za-z0-9_.-]/-/g; s/_+/_/g; s/-+/-/g')"
  printf '%s' "$session"
}

issue_number_from_slug() {
  local slug="$1"
  printf '%s' "$slug" | sed -nE 's/^([0-9]+)-.*/\1/p'
}

truncate_str() {
  local str="$1"
  local max_len="${2:-40}"
  if [ "${#str}" -gt "$max_len" ]; then
    printf '%s...' "${str:0:$((max_len - 3))}"
  else
    printf '%s' "$str"
  fi
}

gh_issue_json() {
  local repo_main="$1"
  local issue_number="$2"
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"
  gh issue view "$issue_number" --repo "$nwo" --json number,title,body,labels,comments,url,assignees
}

ensure_labels() {
  local repo_main="$1"
  local label color

  # Lifecycle labels with distinct colors per stage
  local lifecycle_colors
  lifecycle_colors="triage:d73a4a"
  lifecycle_colors="$lifecycle_colors ready-for-spec:0e8a16"
  lifecycle_colors="$lifecycle_colors spec-in-progress:1d76db"
  lifecycle_colors="$lifecycle_colors spec-review:fbca04"
  lifecycle_colors="$lifecycle_colors spec-approved:0052cc"
  lifecycle_colors="$lifecycle_colors implementing:5319e7"
  lifecycle_colors="$lifecycle_colors in-review:f9d0c4"
  lifecycle_colors="$lifecycle_colors review-pass:0e8a16"
  lifecycle_colors="$lifecycle_colors review-blocked:d73a4a"
  lifecycle_colors="$lifecycle_colors review-skipped:e4e669"
  lifecycle_colors="$lifecycle_colors done:cccccc"

  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"

  for label in "${LIFECYCLE_LABELS[@]}"; do
    color="$(printf '%s' "$lifecycle_colors" | tr ' ' '\n' | grep "^${label}:" | cut -d: -f2)"
    [ -n "$color" ] || color="0052cc"
    gh label create "$label" --repo "$nwo" --color "$color" --description "Acorn lifecycle" --force >/dev/null 2>&1 || true
  done

  for label in "${CLARIFICATION_LABELS[@]}"; do
    gh label create "$label" --repo "$nwo" --color "e4e669" --description "Acorn clarification status" --force >/dev/null 2>&1 || true
  done
}

remove_issue_label_soft() {
  local repo_main="$1"
  local issue_number="$2"
  local label="$3"
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"
  gh issue edit "$issue_number" --repo "$nwo" --remove-label "$label" >/dev/null 2>&1 \
    || warn "Unable to remove label '$label' from issue #$issue_number"
}

add_issue_label_hard() {
  local repo_main="$1"
  local issue_number="$2"
  local label="$3"
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"
  gh issue edit "$issue_number" --repo "$nwo" --add-label "$label" >/dev/null \
    || die "Failed adding label '$label' on issue #$issue_number"
}

set_issue_state_label() {
  local repo_main="$1"
  local issue_number="$2"
  local target="$3"
  local label

  for label in "${LIFECYCLE_LABELS[@]}"; do
    if [ "$label" != "$target" ]; then
      remove_issue_label_soft "$repo_main" "$issue_number" "$label"
    fi
  done

  add_issue_label_hard "$repo_main" "$issue_number" "$target"
}

set_clarification_label() {
  local repo_main="$1"
  local issue_number="$2"
  local target="$3"
  local label

  for label in "${CLARIFICATION_LABELS[@]}"; do
    if [ "$label" != "$target" ]; then
      remove_issue_label_soft "$repo_main" "$issue_number" "$label"
    fi
  done

  add_issue_label_hard "$repo_main" "$issue_number" "$target"
}

comment_issue() {
  local repo_main="$1"
  local issue_number="$2"
  local body="$3"
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"
  gh issue comment "$issue_number" --repo "$nwo" --body "$body" >/dev/null \
    || warn "Failed posting comment on issue #$issue_number"
}

# Resolve GitHub owner/repo (nameWithOwner) from local repo path.
gh_repo_nwo() {
  local repo_main="$1"
  (
    cd "$repo_main"
    git remote get-url origin \
      | sed -E 's|.*github\.com[:/](.+)\.git$|\1|; s|.*github\.com[:/](.+)$|\1|'
  ) || die "Failed to resolve GitHub repo name from: $repo_main"
}

# Fetch issues that block a given issue.
# Returns JSON array from GitHub API, or '[]' on failure.
get_blocked_by() {
  local repo_main="$1"
  local issue_number="$2"
  local nwo="${3:-}"
  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  local result
  result="$(
    cd "$repo_main"
    gh api "repos/${nwo}/issues/${issue_number}/dependencies/blocked_by" 2>/dev/null
  )" || { printf '[]'; return 0; }

  if printf '%s' "$result" | jq -e 'type == "array"' >/dev/null 2>&1; then
    printf '%s' "$result"
  else
    printf '[]'
  fi
}

# Fetch issues that a given issue blocks (reverse direction).
# Returns JSON array, or '[]' on failure.
get_blocking() {
  local repo_main="$1"
  local issue_number="$2"
  local nwo="${3:-}"
  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  local result
  result="$(
    cd "$repo_main"
    gh api "repos/${nwo}/issues/${issue_number}/dependencies/blocking" 2>/dev/null
  )" || { printf '[]'; return 0; }

  if printf '%s' "$result" | jq -e 'type == "array"' >/dev/null 2>&1; then
    printf '%s' "$result"
  else
    printf '[]'
  fi
}

# Add a single blocked-by relationship.
# Returns 0 on success, 1 on failure (with warning).
add_blocked_by_dependency() {
  local repo_main="$1"
  local issue_number="$2"
  local blocker_number="$3"
  local nwo="${4:-}"

  case "$blocker_number" in
    ''|*[!0-9]*) warn "Invalid issue number for --blocked-by: '$blocker_number'"; return 1 ;;
  esac
  [ "$blocker_number" -gt 0 ] 2>/dev/null || { warn "Invalid issue number for --blocked-by: '$blocker_number'"; return 1; }

  if [ "$issue_number" = "$blocker_number" ]; then
    warn "Issue #$issue_number cannot block itself"
    return 1
  fi

  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  info "Adding dependency: #$issue_number blocked by #$blocker_number"
  (
    cd "$repo_main"
    gh api --method POST \
      "repos/${nwo}/issues/${issue_number}/dependencies/blocked_by" \
      -f blocked_by_issue_number="$blocker_number" >/dev/null
  ) || { warn "Failed to add blocked-by #$blocker_number for issue #$issue_number"; return 1; }
}

# Remove a single blocked-by relationship.
# Returns 0 on success, 1 on failure (with warning).
remove_blocked_by_dependency() {
  local repo_main="$1"
  local issue_number="$2"
  local blocker_number="$3"
  local nwo="${4:-}"

  case "$blocker_number" in
    ''|*[!0-9]*) warn "Invalid issue number for --remove-blocked-by: '$blocker_number'"; return 1 ;;
  esac

  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"
  info "Removing dependency: #$issue_number no longer blocked by #$blocker_number"
  (
    cd "$repo_main"
    gh api --method DELETE \
      "repos/${nwo}/issues/${issue_number}/dependencies/blocked_by/${blocker_number}" >/dev/null
  ) || { warn "Failed to remove blocked-by #$blocker_number from issue #$issue_number"; return 1; }
}

_emit_pi_ship_warning() {
  # Warning-only check for issue-body Pi-ship deps.
  local repo="$1"
  local slug="$2"
  local body="$3"

  local lib_dir=""
  for candidate in \
    "$HOME/.foreman/lib" \
    "/mnt/e/agentdev/projects/forge/main/runtime/foreman/lib" \
    "$HOME/projects/forge/main/runtime/foreman/lib"; do
    if [ -f "$candidate/pi_ship_dependency.py" ]; then
      lib_dir="$candidate"
      break
    fi
  done
  [ -n "$lib_dir" ] || return 0

  local declared_json
  declared_json="$(printf '%s' "$body" | awk '
      BEGIN { in_section=0; in_block=0; printed=0 }
      /^## Pi-Ship Dependencies[[:space:]]*$/ { if (!printed) { in_section=1; next } }
      in_section && /^## / { in_section=0 }
      in_section && /^```json[[:space:]]*$/ { in_block=1; next }
      in_section && in_block && /^```[[:space:]]*$/ { in_block=0; printed=1; in_section=0; exit }
      in_section && in_block { print }
  ' 2>/dev/null || true)"

  [ -n "$declared_json" ] || return 0
  if ! printf '%s' "$declared_json" | jq -e -c '.' >/dev/null 2>&1; then
    warn "acorn create: malformed Pi-Ship Dependencies JSON block in issue body"
    return 0
  fi
  declared_json="$(printf '%s' "$declared_json" | jq -c '.')"

  local projects_dir="${FORGE_PROJECTS_DIR:-${PROJECTS_DIR:-/mnt/e/agentdev/projects}}"
  local result_json=""
  set +e
  result_json="$(PYTHONPATH="$lib_dir" timeout 15s python3 -m pi_ship_dependency \
    "$slug" \
    --declared-json "$declared_json" \
    --repo "$repo" \
    --worktree "${PI_SHIP_GATE_WORKTREE:-main}" \
    --projects-dir "$projects_dir" 2>/dev/null)"
  local ec=$?
  set -e

  if [ "$ec" -eq 1 ]; then
    local missing
    missing="$(printf '%s' "$result_json" | jq -r '.missing_deps[] | "  - \(.spec_id) (\(.reason))"' 2>/dev/null || true)"
    [ -n "$missing" ] && warn "acorn create: declared Pi-ship deps not yet shipped for $slug:\n$missing"
  fi
}

# Detect if adding "issue_number blocked-by blocker_number" would create a cycle.
# Returns 0 if cycle detected, 1 if safe.
detect_circular_dependency() {
  local repo_main="$1"
  local issue_number="$2"
  local blocker_number="$3"
  local nwo="${4:-}"
  [ -n "$nwo" ] || nwo="$(gh_repo_nwo "$repo_main")"

  local visited="$issue_number"

  _cycle_dfs() {
    local current="$1"
    local blockers_json
    blockers_json="$(get_blocked_by "$repo_main" "$current" "$nwo")"
    local dep_num
    while IFS= read -r dep_num; do
      [ -n "$dep_num" ] || continue
      if [ "$dep_num" = "$issue_number" ]; then
        return 0
      fi
      case " $visited " in
        *" $dep_num "*) continue ;;
      esac
      visited="$visited $dep_num"
      _cycle_dfs "$dep_num" && return 0
    done < <(printf '%s' "$blockers_json" | jq -r '.[].number // empty')
    return 1
  }

  _cycle_dfs "$blocker_number"
  local result=$?
  unset -f _cycle_dfs 2>/dev/null || true
  return $result
}

# Add multiple blocked-by dependencies with cycle detection.
add_blocked_by_bulk() {
  local repo_main="$1"
  local issue_number="$2"
  shift 2
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"
  local num
  for num in "$@"; do
    num="$(printf '%s' "$num" | tr -d '[:space:]')"
    [ -n "$num" ] || continue
    if detect_circular_dependency "$repo_main" "$issue_number" "$num" "$nwo"; then
      warn "Circular dependency: adding #$num as blocker of #$issue_number would create a cycle. Skipping."
      continue
    fi
    add_blocked_by_dependency "$repo_main" "$issue_number" "$num" "$nwo" || true
  done
}

# Return the count of issues blocking a given issue.
blocked_by_count() {
  local repo_main="$1"
  local issue_number="$2"
  local nwo="${3:-}"
  local json
  json="$(get_blocked_by "$repo_main" "$issue_number" "$nwo")"
  printf '%s' "$json" | jq 'length'
}

# Build dependency graph for a set of issues.
# Output: lines of "ISSUE BLOCKER" pairs, or "ISSUE NONE" for unblocked issues.
build_dependency_graph() {
  local repo_main="$1"
  shift
  local issues=("$@")
  local nwo
  nwo="$(gh_repo_nwo "$repo_main")"

  local issue
  for issue in "${issues[@]}"; do
    local blockers_json
    blockers_json="$(get_blocked_by "$repo_main" "$issue" "$nwo")"
    local has_dep=0
    local dep_num
    while IFS= read -r dep_num; do
      [ -n "$dep_num" ] || continue
      local in_set=0
      local check
      for check in "${issues[@]}"; do
        [ "$check" != "$dep_num" ] || { in_set=1; break; }
      done
      if [ "$in_set" -eq 1 ]; then
        printf '%s %s\n' "$issue" "$dep_num"
        has_dep=1
      fi
    done < <(printf '%s' "$blockers_json" | jq -r '.[].number // empty')
    if [ "$has_dep" -eq 0 ]; then
      printf '%s NONE\n' "$issue"
    fi
  done
}

# Topological sort using Kahn's algorithm.
# Reads dependency pairs from stdin ("ISSUE BLOCKER" or "ISSUE NONE").
# Outputs waves separated by "---" lines.
topological_sort_waves() {
  local all_issues=""
  local edges=""

  while IFS=' ' read -r issue dep; do
    case " $all_issues " in
      *" $issue "*) ;;
      *) all_issues="$all_issues $issue" ;;
    esac
    if [ "$dep" != "NONE" ]; then
      edges="$edges|$issue $dep"
    fi
  done

  all_issues="${all_issues# }"
  [ -n "$all_issues" ] || return 0

  local remaining="$all_issues"
  local wave_num=0

  while [ -n "$remaining" ]; do
    wave_num=$((wave_num + 1))
    local wave_issues=""

    local candidate
    for candidate in $remaining; do
      local is_blocked=0
      IFS='|'
      local edge
      for edge in $edges; do
        [ -n "$edge" ] || continue
        local e_blocked="${edge%% *}"
        local e_blocker="${edge##* }"
        if [ "$e_blocked" = "$candidate" ]; then
          case " $remaining " in
            *" $e_blocker "*) is_blocked=1; break ;;
          esac
        fi
      done
      IFS=$'\n\t'
      if [ "$is_blocked" -eq 0 ]; then
        wave_issues="$wave_issues $candidate"
      fi
    done

    wave_issues="${wave_issues# }"

    if [ -z "$wave_issues" ]; then
      die "Circular dependency detected in batch: remaining issues [$remaining] have unresolvable dependencies"
    fi

    if [ "$wave_num" -gt 1 ]; then
      printf -- '---\n'
    fi
    local wi
    for wi in $wave_issues; do
      printf '%s\n' "$wi"
    done

    local new_remaining=""
    local r
    for r in $remaining; do
      case " $wave_issues " in
        *" $r "*) ;;
        *) new_remaining="$new_remaining $r" ;;
      esac
    done
    remaining="${new_remaining# }"
  done
}

planning_block() {
  local mode="${1:-full}"
  local spec_path="${2:-.}"
  case "$mode" in
    full)  planning_block_full "$spec_path" ;;
    lite)  planning_block_lite "$spec_path" ;;
    quick) planning_block_quick "$spec_path" ;;
    *)     die "Unknown planning mode: $mode" ;;
  esac
}

planning_block_full() {
  local spec_path="${1:-.}"
  local retry_budget="${ACORN_SUBAGENT_RETRY_BUDGET:-1}"
  local retry_backoff="${ACORN_SUBAGENT_RETRY_BACKOFF_SECONDS:-30}"
  local event_path="${ACORN_FAILURE_EVENT_PATH:-}"
  local event_path_display="${event_path:-(unset — events disabled)}"
  local mode="full"
  case "$retry_budget" in ''|*[!0-9]*) retry_budget=1 ;; esac
  case "$retry_backoff" in ''|*[!0-9]*) retry_backoff=30 ;; esac
  cat <<'METHODOLOGY_EOF' \
    | sed "s|__SPEC_PATH__|${spec_path}|g" \
    | sed "s|__RETRY_BUDGET__|${retry_budget}|g" \
    | sed "s|__RETRY_BACKOFF__|${retry_backoff}|g" \
    | sed "s|__EVENT_PATH_DISPLAY__|${event_path_display}|g" \
    | sed "s|__MODE__|${mode}|g"
## PLANNING METHODOLOGY — MANDATORY INSTRUCTIONS

> **YOU ARE THE ORCHESTRATOR. YOU MUST FOLLOW THIS METHODOLOGY EXACTLY.**
>
> When the user says "let's draft this" (or any variation like "draft it", "start planning", "go", etc.),
> you MUST execute the 5-stage multi-agent pipeline described below.
>
> **DO NOT write a plan yourself. DO NOT skip stages. DO NOT summarize instead of launching agents.**
>
> If you write ANY plan content yourself instead of delegating to sub-agents via the Task tool,
> you have FAILED. Your ONLY job is to launch Task agents and wait for them to finish.

> **RULES FOR SUB-AGENTS (include these in every sub-agent prompt):**
>
> - Sub-agents write ALL work to files using Write/Edit tools
> - Sub-agents return ONLY: `Done. Output: [filepath]`
> - Sub-agents MUST write in chunks of ~4000 tokens max (Write tool, then Edit to append)
> - Sub-agents must NEVER return content, summaries, or explanations to the orchestrator
> - Violation of these rules will blow up the orchestrator's context window

> **VISUAL ASSETS:** The GitHub issue may include images (screenshots, mockups, diagrams) downloaded
> to `__SPEC_PATH__/images/`. Sub-agents should use the Read tool to examine any images when relevant.

---

### Overview

You MUST execute these 5 stages in order. Each stage MUST use the Task tool to launch sub-agents.
You MUST NOT skip any stage. You MUST NOT combine stages. You MUST NOT do the work yourself.

0. **Stage 0**: YOU launch 3 parallel Task agents → each explores the codebase from a different angle
1. **Stage 1**: YOU launch 4 parallel Task agents → each drafts an independent plan with a distinct architectural lens
2. **Stage 2**: YOU launch 1 Task agent → scores all 4 drafts against a structured rubric
3. **Stage 3**: YOU launch 1 Task agent → synthesizes a master plan using scored drafts
4. **Stage 4**: YOU launch 4 parallel Task agents → each adversarially red-teams the master plan
5. **Stage 5**: YOU launch 1 Task agent → produces final SPEC.md with traceability

Total: 13 Task agent launches across 5 stages (Stage 0 through Stage 5). No shortcuts.

